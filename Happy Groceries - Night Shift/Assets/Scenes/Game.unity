MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2021037598}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 33fab4a22f0e62d4ba7bd8e326e14aba, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPCInteraction
  interactionIcon: {fileID: 171311803}
  talkGUI: {fileID: 750613529}
  clientNameText: {fileID: 576075658}
  clientTalkText: {fileID: 1746481623}
  playerButtons:
  - {fileID: 367882620}
  - {fileID: 167906619}
  - {fileID: 1558380667}
  playerButtonsTexts:
  - {fileID: 367882618}
  - {fileID: 167906617}
  - {fileID: 1558380665}
  npcName: Daniel Brooks
  dialogueNodes:
  - frasesDoNPC:
    - frase: "Quite the quiet place, is not it? Makes you wonder what is really going
        on. Do not worry, it is perfectly safe\u2026 probably."
      vozDaFrase: {fileID: 8300000, guid: cedb1b356ab572346903446932e01057, type: 3}
    escolhas:
    - textoDoBotao: Stop joking around. This is not funny. It will be 10.39$.
      proximoNode: 1
    - textoDoBotao: "Heh\u2026 yeah, it is a bit eerie, but I am okay. The total
        is 10.39$."
      proximoNode: 2
    - textoDoBotao: Why probably? There is are a murder in the town. The price is
        10.39$.
      proximoNode: 3
  - frasesDoNPC:
    - frase: Godamn! Can you give me a discount?
      vozDaFrase: {fileID: 8300000, guid: 59333f6548cb6014a989ea6ff37e5566, type: 3}
    escolhas:
    - textoDoBotao: No, if you will not pay leave.
      proximoNode: 4
  - frasesDoNPC:
    - frase: Keep the change.
      vozDaFrase: {fileID: 8300000, guid: 37c9f354b2b7cf44fab1e30f479d49ee, type: 3}
    escolhas:
    - textoDoBotao: ...
      proximoNode: -1
  - frasesDoNPC:
    - frase: Do not matter. Keep the change, you might need it.
      vozDaFrase: {fileID: 8300000, guid: 045dc1d3cc0bdb5438fdb4244a006422, type: 3}
    escolhas:
    - textoDoBotao: ...
      proximoNode: -1
  - frasesDoNPC:
    - frase: Fine... Keep the change. You might need it.
      vozDaFrase: {fileID: 0}
    escolhas:
    - textoDoBotao: ...
      proximoNode: -1
  typingSpeed: 0.05
  typingSound: {fileID: 8300000, guid: 75d2951302e3494489f453697f0c8336, type: 3}
  defaultVoiceClip: {fileID: 0}
  usesMachine: 1
  machineAnimator: {fileID: 51923035}
  autoStartDialogue: 0
