  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPCInteraction
  interactionIcon: {fileID: 171311803}
  talkGUI: {fileID: 750613529}
  clientNameText: {fileID: 576075658}
  clientTalkText: {fileID: 1746481623}
  playerButtons:
  - {fileID: 367882620}
  - {fileID: 167906619}
  - {fileID: 1558380667}
  playerButtonsTexts:
  - {fileID: 367882618}
  - {fileID: 167906617}
  - {fileID: 1558380665}
  npcName: Thomas Hale
  dialogueNodes:
  - frasesDoNPC:
    - frase: Excuse me, could you spare some food? I am really hungry.
      vozDaFrase: {fileID: 0}
    escolhas:
    - textoDoBotao: No, I cannot give you anything.
      proximoNode: 1
    - textoDoBotao: I wish I could, but I cannot.
      proximoNode: 2
    - textoDoBotao: I... I cannot give you anything.
      proximoNode: 2
  - frasesDoNPC:
    - frase: Please, just a little? I have not eaten all day.
      vozDaFrase: {fileID: 0}
    escolhas:
    - textoDoBotao: The owner does not allow it.
      proximoNode: 3
    - textoDoBotao: The owner says I cannot give food.
      proximoNode: 4
    - textoDoBotao: The owner said no, I am sorry.
      proximoNode: 4
  - frasesDoNPC:
    - frase: Come on, just a small piece, I am desperate.
      vozDaFrase: {fileID: 0}
    escolhas:
    - textoDoBotao: I said no.
      proximoNode: 3
    - textoDoBotao: I am really sorry, I cannot help.
      proximoNode: 3
    - textoDoBotao: I cannot, please understand.
      proximoNode: 4
  - frasesDoNPC:
    - frase: Alright, I will leave. I just hoped someone would help.
      vozDaFrase: {fileID: 0}
    escolhas:
    - textoDoBotao: ...
      proximoNode: -1
  - frasesDoNPC:
    - frase: Thank you anyway, I will try somewhere else.
      vozDaFrase: {fileID: 0}
    escolhas:
    - textoDoBotao: ...
      proximoNode: -1
