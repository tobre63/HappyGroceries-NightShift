--- !u!114 &2125522916
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2125522906}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 33fab4a22f0e62d4ba7bd8e326e14aba, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NpcDialogue
  interactionIcon: {fileID: 171311803}
  talkGUI: {fileID: 750613529}
  clientNameText: {fileID: 576075658}
  clientTalkText: {fileID: 1746481623}
  playerButtons:
  - {fileID: 367882620}
  - {fileID: 167906619}
  - {fileID: 1558380667}
  playerButtonsTexts:
  - {fileID: 367882618}
  - {fileID: 167906617}
  - {fileID: 1558380665}
  npcName: Harold Finch
  dialogueNodes:
  - frasesDoNPC:
    - frase: Good evening. I hope your shift has been treating you well tonight.
      vozDaFrase: {fileID: 0}
    escolhas:
    - textoDoBotao: Just tell me what you need. Total is 5.29$.
      proximoNode: 1
    - textoDoBotao: It has been a quiet night so far. Total is 5.29$.
      proximoNode: 2
    - textoDoBotao: It has been fine. Total is 5.29$.
      proximoNode: 3
  - frasesDoNPC:
    - frase: I see. No need for the attitude, young man. Are you new around here?
      vozDaFrase: {fileID: 0}
    escolhas:
    - textoDoBotao: New or not, it is none of your concern.
      proximoNode: -1
    - textoDoBotao: Yes, I just started. It has been interesting.
      proximoNode: 4
    - textoDoBotao: Yes, I just started. I hope I am doing okay.
      proximoNode: 4
  - frasesDoNPC:
    - frase: That is good to hear. Quiet nights are always nice. Do you enjoy your
        work here?
      vozDaFrase: {fileID: 0}
    escolhas:
    - textoDoBotao: Enjoy it or not, I still get the job done.
      proximoNode: -1
    - textoDoBotao: I am, thank you. The people here are kind.
      proximoNode: 4
    - textoDoBotao: I think so. I am still learning.
      proximoNode: 4
  - frasesDoNPC:
    - frase: You seem tense. Long shifts can be tough. Do you manage the stress well?
      vozDaFrase: {fileID: 0}
    escolhas:
    - textoDoBotao: I handle it just fine, thank you.
      proximoNode: -1
    - textoDoBotao: I do my best. It is not too bad.
      proximoNode: 4
    - textoDoBotao: I try. It can be overwhelming sometimes.
      proximoNode: 4
  - frasesDoNPC:
    - frase: Good to hear. Have a great night.
      vozDaFrase: {fileID: 0}
    escolhas:
    - textoDoBotao: ...
      proximoNode: -1
  typingSpeed: 0.05
  typingSound: {fileID: 8300000, guid: 75d2951302e3494489f453697f0c8336, type: 3}
  defaultVoiceClip: {fileID: 8300000, guid: 7bdc83003244cc04eb497026ce910abc, type: 3}
  usesMachine: 1
  machineAnimator: {fileID: 51923035}
  autoStartDialogue: 0
