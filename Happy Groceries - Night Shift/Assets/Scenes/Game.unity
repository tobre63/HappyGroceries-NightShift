  m_Script: {fileID: 11500000, guid: 33fab4a22f0e62d4ba7bd8e326e14aba, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPCInteraction
  interactionIcon: {fileID: 0}
  talkGUI: {fileID: 750613529}
  clientNameText: {fileID: 576075658}
  clientTalkText: {fileID: 1746481623}
  playerButtons:
  - {fileID: 367882620}
  - {fileID: 167906619}
  - {fileID: 1558380667}
  playerButtonsTexts:
  - {fileID: 367882618}
  - {fileID: 167906617}
  - {fileID: 1558380665}
  npcName: Oliver Grant
  dialogueNodes:
  - frasesDoNPC:
    - frase: Hi! Sorry to disturb you.
      vozDaFrase: {fileID: 0}
    escolhas:
    - textoDoBotao: You should not be wandering around alone.
      proximoNode: 1
    - textoDoBotao: Hey there, are you playing? It is late for a kid to be out.
      proximoNode: 1
    - textoDoBotao: "It is really not safe to be here\u2026you should not be here
        alone."
      proximoNode: 1
  - frasesDoNPC:
    - frase: "It is okay\u2026 I am fine here. Are you too?"
      vozDaFrase: {fileID: 0}
    escolhas:
    - textoDoBotao: Why do you care? Stay out of trouble.
      proximoNode: 2
    - textoDoBotao: "I\u2026 I am okay, thanks for asking."
      proximoNode: 2
    - textoDoBotao: "I guess I am fine\u2026 just\u2026 do not go anywhere strange."
      proximoNode: 2
  - frasesDoNPC:
    - frase: I just want to make sure you are safe.
      vozDaFrase: {fileID: 0}
    escolhas:
    - textoDoBotao: Weirdo.
      proximoNode: -1
    - textoDoBotao: "Thanks\u2026 I appreciate that."
      proximoNode: -1
    - textoDoBotao: "I\u2019m not sure\u2026 it is a bit weird here\u2026"
      proximoNode: -1
  typingSpeed: 0.05
  typingSound: {fileID: 8300000, guid: 75d2951302e3494489f453697f0c8336, type: 3}
