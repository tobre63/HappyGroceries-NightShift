      vozDaFrase: {fileID: 8300000, guid: 946bd95fc578dde4696d4a6258502bea, type: 3}
    escolhas:
    - textoDoBotao: Calm down. I am not your guide. I bet you are joking.
      proximoNode: 1
    - textoDoBotao: What? It is just down the street, turn left at the corner.
      proximoNode: 2
    - textoDoBotao: "Oh\u2026 a murder? I\u2026 I really do not know where it is\u2026"
      proximoNode: 3
  - frasesDoNPC:
    - frase: Get lost, man! Hope you die.
      vozDaFrase: {fileID: 8300000, guid: 135167c22a9136f4aa8acd4afa4a9c6d, type: 3}
    escolhas:
    - textoDoBotao: ...
      proximoNode: -1
  - frasesDoNPC:
    - frase: Thank you so much.
      vozDaFrase: {fileID: 8300000, guid: c699349847ce67e46908bf5ea18e4b85, type: 3}
    escolhas:
    - textoDoBotao: ...
      proximoNode: -1
  - frasesDoNPC:
    - frase: Thank you anyways.
      vozDaFrase: {fileID: 8300000, guid: fbd6aa872d3970b44bb304468f827eff, type: 3}
    escolhas:
    - textoDoBotao: ...
      proximoNode: -1
